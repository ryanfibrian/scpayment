# Salin file ini menjadi ".env" lalu isi sesuai data cPanel Anda.
# JANGAN commit file ".env" (sudah masuk .gitignore).

# --- Database MySQL (buat lewat cPanel > MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vicmic_scpayment
DB_USER=vicmic_scpayment_user
DB_PASSWORD=isi_password_disini

# --- Session ---
# String acak bebas, minimal 32 karakter, buat sekali lalu jangan diubah-ubah
SESSION_SECRET=ganti_dengan_string_acak_yang_panjang_dan_rahasia

# --- Port (cPanel Node.js App otomatis inject PORT, biarkan default untuk lokal) ---
PORT=3000

# --- Dipakai HANYA saat menjalankan scripts/create-admin.js ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_kuat_disini
